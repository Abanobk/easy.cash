# MySQL
MYSQL_DATABASE=easy_cash
MYSQL_USER=easy_cash
# Use strong passwords. Avoid spaces; if you use ! @ # wrap in single quotes on the server .env
MYSQL_PASSWORD=change-this-mysql-password
MYSQL_ROOT_PASSWORD=change-this-root-password

# التطبيق
APP_PORT=8099
APP_URL=https://cash.easytecheg.net
# Origins مسموحة لـ CORS (لوحة hub / Easy Shope) — مفصولة بفاصلة
# CORS_ORIGINS=https://easytecheg.net,https://www.easytecheg.net
JWT_SECRET=replace-with-a-long-random-secret-at-least-24-chars
# نفس Easy Shop — لتشفير مفاتيح Paymob (يمكن أن يساوي JWT_SECRET)
ENCRYPTION_KEY=replace-with-a-long-random-encryption-key-32
VITE_APP_TITLE=Easy Cash - برنامج المحاسبة

# أمان: في الإنتاج ارفض HMAC الفارغ لـ Paymob (افتراضي 1)
# PAYMOB_REQUIRE_HMAC=1
# للتطوير فقط: PAYMOB_ALLOW_UNSIGNED=1
# للتطوير فقط: ALLOW_WEAK_SECRETS=1
# لتفعيل OAuth القديم (Manus): ENABLE_MANUS_OAUTH=1

# حماية التسجيل من البوتات (Cloudflare Turnstile — مجاني)
# التسجيل يبقى مفتوحاً لأي عميل؛ التحقق يفلتر الروبوتات فقط
# من https://dash.cloudflare.com → Turnstile → أضف موقعك
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
# بدون المفاتيح يظهر checkbox «أنا لست روبوتاً» + honeypot

# مساعد الذكاء الاصطناعي — نفس Ollama / نفس موديلات Easy Tech (Flutter App 2)
# TrueNAS: الاتصال المباشر بحاوية Ollama (شغّل scripts/setup-ollama-truenas.sh)
OLLAMA_DOCKER_NETWORK=ix-ollama_default
OLLAMA_BASE_URL=http://ix-ollama-ollama-1:11434
# Mac (تطوير محلي): OLLAMA_BASE_URL=http://host.docker.internal:11434
# مطابقة Flutter: qwen3:14b | auto = يفضّل qwen3:14b إن وُجد وإلا أقوى موديل
OLLAMA_MODEL=qwen3:14b
# للمراجع / كشوف PDF / وارد واتساب (تحليل أثقل) — نفس Easy Tech HEAVY
OLLAMA_MODEL_HEAVY=qwen3:14b
# اختياري لصور الشيكات: qwen2.5vl (اسم Ollama الصحيح) أو llava
# OLLAMA_VISION_MODEL=qwen2.5vl
OLLAMA_ENABLED=1

# Cron للتنبيهات التشغيلية / توجيه الشيكات (اختياري)
# CRON_SECRET=change-this-cron-secret
# مثال يومي: curl -X POST -H "x-cron-secret: $CRON_SECRET" https://cash.easytecheg.net/api/cron/operational-sync

# اختياري — تخزين الملفات على S3 (لوغو الشركة وغيره)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=
# AWS_S3_BUCKET=

# ربط Easy Shope ↔ Easy Cash (مزامنة أصناف وفواتير) — سر قوي عشوائي (≥24)
SHOPE_INTEGRATION_SECRET=replace-with-a-long-random-shope-integration-secret
SHOPE_API_URL=https://easytecheg.net

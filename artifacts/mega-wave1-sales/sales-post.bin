    <script type="text/javascript">
        var fiscalYearStart = '1/1/2022';
        var fiscalYearEnd = '31/12/2026';
        var WinID = '622a5182-24e1-4373-bc7c-1ccc1f7fc601';
        var appRootPath = '../'
        function SetPageTitle() {
            $(".treeview li a", window.parent.document).removeClass("ActiveMenuLink");
            $("a[name=pageID_" + '173' + "]", window.parent.document).addClass("ActiveMenuLink");
            $("#pageImg").attr("src", '../Images/mod-reports.png');
            $("#lblPageTitle").text('البيع');
            $("title", window.parent.document).text('Mega Cash | ' + 'البيع');
        }


        $(document).ready(function () {
            if (window != window.top &&
                !new URLSearchParams(window.location.search).has("OverrideDatabase") &&
                window.parent.TheXData != 'eCaONV+iYJx4A0SpGq/ODu5FOZixQA5exIa0g93gZfY=') {
                window.parent.location.reload();
            }
        });

        function WebForm_OnSubmit() {

            $("input").removeClass("ErrorValidateControl");
            if (typeof (ValidatorOnSubmit) == "function" && ValidatorOnSubmit() == false) {
                for (var i in Page_Validators) {

                    try {
                        var control = document.getElementById(Page_Validators[i].controltovalidate);
                        if (!Page_Validators[i].isvalid) {

                            if ($(control).attr("class") != undefined && $(control).attr("class").indexOf("hf_Autocomplete") != -1) {
                                $(control).prevAll("input").addClass("ErrorValidateControl");
                            }
                            else {

                                $(control).addClass("ErrorValidateControl");
                            }
                        }
                    } catch (e) { }
                }
                isValidationSuccess = false;
                return false;
            }
            isValidationSuccess = true;
            return true;
        }

        function WebForm_TextBoxKeyHandler(event) {

            if (event.keyCode == 13) {

                let target = event.target || event.srcElement;
                if (target.value == $(target).attr("OriginalValue")) return true;

                if ((typeof (target) != "undefined") && (target != null)) {
                    if (typeof (target.onchange) != "undefined") {
                        target.onchange();
                        event.cancelBubble = true;
                        if (event.stopPropagation) event.stopPropagation();
                        return ($(target).closest('table.grd').length > 0);
                    }
                }
            }
            return true;
        }

    </script>
